# ==============================================================================
# MaxPayout Application Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the root folder, and/or load it into your shell before running.

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL database connection string used by the 'api' server crate.
# Update with your local database username, password, host, and database name.
DATABASE_URL=postgresql://localhost/rfn_dev

# ------------------------------------------------------------------------------
# 2. Resend Email Delivery API (For Magic Links)
# ------------------------------------------------------------------------------
# Set this key to enable real email delivery via Resend.
# If blank, the system logs Magic Link URLs directly to the terminal stdout
# for zero-setup local developer testing.
# RESEND_API_KEY=re_your_secret_resend_api_key_here

# The sender address to send magic links from.
# If using a Resend onboarding/trial account, use onboarding@resend.dev.
# If using a verified domain, use your registered address (e.g., login@yourdomain.com).
RESEND_SENDER=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 3. Local Development Toggles
# ------------------------------------------------------------------------------
# Set to 'true' to display mock magic links directly on the UI login screen.
# Perfect for lightning-fast testing without checking console output or email.
SHOW_LOCAL_TESTING_LINKS=true

# ------------------------------------------------------------------------------
# 4. WASI Storage Configuration
# ------------------------------------------------------------------------------
# Virtual folder used for WASI/Spin filesystem persistence.
# For local wasmtime/spin execution, this maps to the local directory `./data`.
STORAGE_PATH=/data

# ------------------------------------------------------------------------------
# 5. OAuth 2.0 Credentials (Real Integrations)
# ------------------------------------------------------------------------------
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Apple Sign In (Requires Elliptic Curve P-256 Key Signatures)
APPLE_CLIENT_ID=com.goldcoders.maxpayout.service
APPLE_TEAM_ID=ABC123XYZ
APPLE_KEY_ID=KEY1234567
APPLE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg...\n-----END PRIVATE KEY-----"

# Microsoft Azure OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-guid
MICROSOFT_CLIENT_SECRET=your-microsoft-secret-value

# Facebook Identity OAuth
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# ------------------------------------------------------------------------------
# 6. OAuth Local/Fake Provider Endpoint Overrides (Optional)
# ------------------------------------------------------------------------------
# Leave these blank for real providers. Set them in local tests when routing OAuth
# through a fake OIDC or Facebook-compatible provider.
# OAUTH_GOOGLE_AUTH_URL=http://127.0.0.1:9001/google/authorize
# OAUTH_GOOGLE_TOKEN_URL=http://127.0.0.1:9001/google/token
# OAUTH_GOOGLE_JWKS_URL=http://127.0.0.1:9001/google/jwks
# OAUTH_GOOGLE_PROFILE_URL=
# OAUTH_GOOGLE_ISSUER=http://127.0.0.1:9001/google
# OAUTH_GOOGLE_SCOPES=openid email profile

# OAUTH_APPLE_AUTH_URL=http://127.0.0.1:9001/apple/authorize
# OAUTH_APPLE_TOKEN_URL=http://127.0.0.1:9001/apple/token
# OAUTH_APPLE_JWKS_URL=http://127.0.0.1:9001/apple/jwks
# OAUTH_APPLE_PROFILE_URL=
# OAUTH_APPLE_ISSUER=http://127.0.0.1:9001/apple
# OAUTH_APPLE_SCOPES=name email

# OAUTH_MICROSOFT_AUTH_URL=http://127.0.0.1:9001/microsoft/authorize
# OAUTH_MICROSOFT_TOKEN_URL=http://127.0.0.1:9001/microsoft/token
# OAUTH_MICROSOFT_JWKS_URL=http://127.0.0.1:9001/microsoft/jwks
# OAUTH_MICROSOFT_PROFILE_URL=http://127.0.0.1:9001/microsoft/me
# OAUTH_MICROSOFT_ISSUER=http://127.0.0.1:9001/microsoft/{tenantid}/v2.0
# OAUTH_MICROSOFT_SCOPES=openid email profile User.Read

# OAUTH_FACEBOOK_AUTH_URL=http://127.0.0.1:9001/facebook/authorize
# OAUTH_FACEBOOK_TOKEN_URL=http://127.0.0.1:9001/facebook/token
# OAUTH_FACEBOOK_JWKS_URL=
# OAUTH_FACEBOOK_PROFILE_URL=http://127.0.0.1:9001/facebook/me?fields=id,email,name
# OAUTH_FACEBOOK_ISSUER=
# OAUTH_FACEBOOK_SCOPES=email
